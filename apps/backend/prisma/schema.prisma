generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  password_hash        String
  name                 String?
  role                 Role
  discipline           Discipline?
  signature_image_path String?
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  punch_items          PunchItem[]
  history_logs         PunchItemHistory[]
}

model PunchItem {
  id                String             @id @default(uuid())
  running_no        String             @unique
  discipline        Discipline
  category          Category           @default(C)
  package           String?
  system            String?
  location          String?
  kks_tag           String?
  description       String
  status            Status             @default(OPEN)
  before_image_path   String?
  before_image_desc   String?
  before_image_2_path String?
  after_image_path    String?
  after_image_desc    String?
  after_image_2_path  String?
  created_by_id     String
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  created_by        User               @relation(fields: [created_by_id], references: [id])
  history           PunchItemHistory[]
}

model PunchItemHistory {
  id                      String    @id @default(uuid())
  punch_item_id           String
  user_id                 String
  action                  Action
  comment                 String?
  signature_snapshot_path String?
  timestamp               DateTime  @default(now())
  punch_item              PunchItem @relation(fields: [punch_item_id], references: [id])
  user                    User      @relation(fields: [user_id], references: [id])
}

enum Role {
  ADMIN
  CONTRACTOR
  OE
  OWNER
}

enum Category {
  A
  B
  C
}

enum Discipline {
  CIV
  MEC
  ELE
  CSI
  COM
}

enum Status {
  OPEN
  CANCELED
  SUBMIT_TO_OE
  SUBMIT_TO_OWNER
  REJECTED
  CLOSED
}

enum Action {
  CREATED
  UPDATED
  SUBMITTED_TO_OE
  SUBMITTED_TO_OWNER
  REJECTED
  REPLIED
  APPROVED
  CANCELED
}

model Setting {
  key   String @id
  value String
}
