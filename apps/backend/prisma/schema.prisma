generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(uuid())
  email                String             @unique
  password_hash        String
  name                 String?
  role                 Role
  discipline           Discipline?
  signature_image_path String?
  project_id           String?
  project              Project?           @relation(fields: [project_id], references: [id])
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  punch_items          PunchItem[]
  history_logs         PunchItemHistory[]
}

model PunchItem {
  id                String             @id @default(uuid())
  running_no        String
  discipline        Discipline
  category          Category           @default(C)
  package           String?
  system            String?
  location          String?
  kks_tag           String?
  description       String
  status            Status             @default(OPEN)
  before_image_path   String?
  before_image_desc   String?
  before_image_2_path String?
  after_image_path    String?
  after_image_desc    String?
  after_image_2_path  String?
  created_by_id     String
  project_id        String?
  project           Project?           @relation(fields: [project_id], references: [id])
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  created_by        User               @relation(fields: [created_by_id], references: [id])
  history           PunchItemHistory[]

  @@unique([project_id, running_no])
}

model PunchItemHistory {
  id                      String    @id @default(uuid())
  punch_item_id           String
  user_id                 String
  action                  Action
  comment                 String?
  signature_snapshot_path String?
  timestamp               DateTime  @default(now())
  punch_item              PunchItem @relation(fields: [punch_item_id], references: [id])
  user                    User      @relation(fields: [user_id], references: [id])
}

enum Role {
  SUPERADMIN
  ADMIN
  CONTRACTOR
  OE
  OWNER
  SUPERVISOR
}

enum Category {
  A
  B
  C
}

enum Discipline {
  CIV
  MEC
  ELE
  CSI
  COM
}

enum Status {
  OPEN
  CANCELED
  SUBMIT_TO_OE
  SUBMIT_TO_OWNER
  REJECTED
  CLOSED
}

enum Action {
  CREATED
  UPDATED
  SUBMITTED_TO_OE
  SUBMITTED_TO_OWNER
  REJECTED
  REPLIED
  APPROVED
  CANCELED
}

model Setting {
  key   String @id
  value String
}

model Package {
  id                String    @id @default(uuid())
  package_name      String    @unique
  max_punch_items   Int?      // null = Unlimited
  pwa_enabled       Boolean   @default(false)
  report_enabled    Boolean   @default(false)
  duration_months   Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  projects          Project[]
}

enum ProjectStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

model Project {
  id              String         @id @default(uuid())
  name            String
  package_id      String?
  package         Package?       @relation(fields: [package_id], references: [id])
  customer_name   String?
  customer_info   String?
  admin_name      String?
  admin_contact   String?
  duration_months Int?
  start_date      DateTime?
  end_date        DateTime?
  status          ProjectStatus  @default(ACTIVE)
  users           User[]
  punch_items     PunchItem[]
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
}
